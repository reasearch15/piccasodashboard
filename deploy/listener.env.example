# Copy to /etc/picasso-telegram-listener/listener.env (root:picasso-tg, chmod 640).
# Never commit the real file. Nothing here is shared with any other application.

# From https://my.telegram.org for the account Picasso's listener logs in with.
PICASSO_TG_API_ID=
PICASSO_TG_API_HASH=
# Picasso's OWN session (Telethon adds ".session"). Never another app's session.
PICASSO_TG_SESSION=/opt/picasso-telegram-listener/state/picasso-listener
PICASSO_LISTENER_STATE=/opt/picasso-telegram-listener/state/cursor.json

PICASSO_TELEGRAM_CHIME_INCOMING_CHAT_ID=
PICASSO_TELEGRAM_VENMO_INCOMING_CHAT_ID=
PICASSO_PAYMENT_START_AT=2026-10-13T00:00:00+05:45

# Local dashboard only (loopback). Same secret as PICASSO_LISTENER_INGEST_SECRET
# in /etc/picasso-dashboard/picasso.env.
PICASSO_LISTENER_INGEST_URL=http://127.0.0.1:3300
PICASSO_LISTENER_INGEST_SECRET=

# Automatic catch-up after downtime is bounded; anything beyond becomes an
# "ingestion gap" in Admin Attention for an approved import. Keep the hours
# below the dashboard's PICASSO_LISTENER_MAX_AGE_HOURS (default 12).
PICASSO_LISTENER_CATCHUP_MAX_HOURS=6
PICASSO_LISTENER_CATCHUP_MAX_MESSAGES=500
PICASSO_LISTENER_FLOOD_WAIT_MAX_SECONDS=900
