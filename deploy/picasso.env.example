# Copy to /etc/picasso-dashboard/picasso.env  (chown root:picasso, chmod 640).
# Never commit the real file.

NODE_ENV=production
PICASSO_LEDGER_MODE=production
PICASSO_PAYMENT_START_AT=2026-10-13T00:00:00+05:45

PICASSO_HOST=127.0.0.1
# Pick a port that is FREE on the VPS (check: sudo ss -ltnp). Nginx proxies to it.
PICASSO_PORT=CHOOSE_A_FREE_PORT
PICASSO_DATA_DIR=/opt/picasso-dashboard/data

PICASSO_ADMIN_USERNAME=CharsiNew
# Do NOT put PICASSO_ADMIN_PASSWORD here; init-admin prompts for it.

PICASSO_COOKIE_SECURE=auto
PICASSO_TRUST_PROXY=true
PICASSO_SESSION_IDLE_MINUTES=120
PICASSO_SESSION_ABSOLUTE_HOURS=12

# Telegram stays OFF until the isolated listener, permissions, group mappings
# and parsers are verified and the owner approves.
PICASSO_TELEGRAM_MODE=off
PICASSO_VENMO_PARSER=review
