# Copy to .env for local overrides. Never commit .env.
# All values below are optional; the defaults are shown.

# Bind to loopback only during local development.
PICASSO_HOST=127.0.0.1
PICASSO_PORT=3000

# Where auth.db and demo-ledger.db are stored.
PICASSO_DATA_DIR=./data

# Only "demo" is supported. The server refuses to start otherwise, so demo
# transactions can never be mistaken for real financial records.
PICASSO_LEDGER_MODE=demo

# Admin account created by `npm run init-admin`.
PICASSO_ADMIN_USERNAME=CharsiNew
# Supply the initial password ONLY for the one-time init command, e.g.
#   PICASSO_ADMIN_PASSWORD='...' npm run init-admin
# Do not store it in this file permanently. If unset, init-admin prompts for it.
# PICASSO_ADMIN_PASSWORD=

# Session lifetime.
PICASSO_SESSION_IDLE_MINUTES=120
PICASSO_SESSION_ABSOLUTE_HOURS=12

# Cookie "Secure" flag: auto (Secure when the request arrived over HTTPS), true, or false.
PICASSO_COOKIE_SECURE=auto
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For / X-Forwarded-Proto.
PICASSO_TRUST_PROXY=false

# Login rate limits (failed attempts per 15 minutes).
PICASSO_LOGIN_MAX_PER_USER_IP=5
PICASSO_LOGIN_MAX_PER_IP=20
PICASSO_LOGIN_MAX_PER_USER=20

# ---- Telegram bridge (Phase 2) ---------------------------------------------
# off (default) | polling (local/dev; outbound only) | webhook (public HTTPS server).
# Exactly one update source ever runs.
PICASSO_TELEGRAM_MODE=off
# From @BotFather. Secret: keep only in .env / server secret store, never in git.
# PICASSO_TELEGRAM_BOT_TOKEN=
# Defaults to the real API. Local development should point at a mock/test server.
# PICASSO_TELEGRAM_API_BASE=https://api.telegram.org
# Safety interlock: must be true to talk to the real api.telegram.org.
PICASSO_TELEGRAM_ALLOW_LIVE=false
# Numeric chat IDs (supergroups look like -100xxxxxxxxxx).
# PICASSO_TELEGRAM_CHIME_INCOMING_CHAT_ID=
# PICASSO_TELEGRAM_VENMO_INCOMING_CHAT_ID=
# PICASSO_TELEGRAM_CHIME_CASHOUT_CHAT_ID=
# PICASSO_TELEGRAM_VENMO_CASHOUT_CHAT_ID=
# Set true only if one chat intentionally serves several roles
# (the two incoming groups can never be the same chat).
PICASSO_TELEGRAM_ALLOW_SHARED_GROUPS=false
# Comma-separated numeric Telegram user IDs allowed to press "Completed".
# PICASSO_TELEGRAM_COMPLETER_IDS=
# Webhook mode only: 32+ random characters, also passed to setWebhook as secret_token.
# PICASSO_TELEGRAM_WEBHOOK_SECRET=
# Optional: enables POST /api/ingest/telegram-message (loopback only) for a separate
# user-account listener (Telethon) that can read other bots' messages. 32+ random chars.
# PICASSO_LISTENER_INGEST_SECRET=

# ---- Go-live -------------------------------------------------------------------
# PICASSO_LEDGER_MODE=production uses data/ledger.db (never seeded, never reset).
# Financial activation boundary. Persisted in the ledger on first start; a different
# value later makes the server refuse to start.
# PICASSO_PAYMENT_START_AT=2026-10-13T00:00:00+05:45
# Venmo has no verified format: review (default) sends Venmo messages to Admin Attention.
# "provisional" is refused in production.
# PICASSO_VENMO_PARSER=review
